# 单镜像：Next.js（3000）+ Python Agent（8000），同一容器内通过 supervisor 启动。
# 数据库、Redis、Ollama 仍建议用 compose 或其它方式单独部署，本镜像只承载应用进程。
FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    supervisor \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable \
 && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV NODE_ENV=production
ENV PYTHON_AGENT_BASE_URL=http://127.0.0.1:8000

RUN pnpm build

RUN pip3 install --no-cache-dir --break-system-packages -r python-agent/requirements.txt

COPY deploy/supervisord.conf /etc/supervisor/conf.d/travel.conf

EXPOSE 3000 8000

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]
