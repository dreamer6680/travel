# ============================================================
# 云服务器生产环境配置
# 复制本文件到服务器仓库根目录，重命名为 .env，按需填写
# 注意：.env 不要提交到 git！
# ============================================================

# ── 安全 ──────────────────────────────────────────────────
# 生成强随机值：openssl rand -base64 32
JWT_SECRET=your-strong-random-secret-change-this

# ── MongoDB ───────────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGODB_DB_NAME=trip

# ── PostgreSQL (pgvector) ─────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=travel_vectors

# ── Redis ─────────────────────────────────────────────────
# 当前使用默认无密码；如需加密码，在 docker-compose.infra.yml 中追加 --requirepass

# ── MinIO 对象存储 ────────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_BUCKET=travel-assets
# 替换为服务器公网 IP 或域名（浏览器直接访问 MinIO 资源）
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=http://YOUR_SERVER_IP:9000/travel-assets

# ── Ollama 模型 ───────────────────────────────────────────
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── AI Agent LLM 配置 ──────────────────────────────────────
# 使用本地 Ollama（默认）
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=openai

# 若需要 OpenAI 作为回退，填写以下值
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── 高德地图 API ──────────────────────────────────────────
NEXT_PUBLIC_AMAP_KEY=
AMAP_WEB_SERVICE_KEY=

# ── 路径规划 API（OpenRouteService） ─────────────────────
OPENROUTESERVICE_API_KEY=

# ── 阿里云 ACR（推送/拉取镜像用，服务器拉取时填写）────────
ACR_REGISTRY=crpi-ylhx24yxbsxfitsd.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=datafollow
APP_TAG=latest
AGENT_TAG=latest

# ── Python Agent 日志级别 ──────────────────────────────────
PY_AGENT_LOG_LEVEL=INFO
