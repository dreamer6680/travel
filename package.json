{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "agent:install": "python3 -m venv python-agent/.venv && python-agent/.venv/bin/pip install -r python-agent/requirements.txt",
    "agent:dev": "python-agent/.venv/bin/uvicorn app.main:app --reload --port 8000 --app-dir python-agent",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:init": "tsx scripts/init-db.ts",
    "db:wait": "tsx scripts/wait-for-mongo.ts",
    "ollama:wait": "tsx scripts/wait-for-ollama.ts",
    "db:setup": "tsx scripts/wait-for-mongo.ts && tsx scripts/init-db.ts",
    "scrape": "tsx scripts/run-scrape.ts",
    "scrape:hotels": "tsx scripts/scrape-ctrip-hotels.ts 2 --target=200 --maxPages=100 --pageSize=20",
    "scrape:restaurants": "tsx scripts/scrape-ctrip-restaurants.ts 2 --target=200 --maxPages=120",
    "vectorize:pg": "tsx scripts/vectorize-mongo-to-pg.ts",
    "bootstrap:all": "tsx scripts/bootstrap-all.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:setup": "docker-compose up -d && npm run db:setup",
    "scrape:shanghai:200": "tsx scripts/scrape-shanghai-200.ts"
  },
